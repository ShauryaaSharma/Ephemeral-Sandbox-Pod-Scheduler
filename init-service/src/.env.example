S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# RS256 private key (PEM) used to sign anonymous session tokens - only
# init-service has this. orchestrator-simple/runner only get JWT_PUBLIC_KEY
# and can only verify. See README "Generating the JWT key pair". In a .env
# file, escape newlines as \n; a k8s Secret can hold the raw multi-line PEM.
JWT_PRIVATE_KEY=
# Shared with orchestrator-simple - must point at the same file (see src/db.ts)
OWNERSHIP_DB_PATH=
# Per-user token-bucket rate limit on POST /project: burst size / refill window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated list of frontend origins allowed to call this API.
# Required when NODE_ENV=production (startup fails otherwise); defaults to
# http://localhost:5173 in development.
ALLOWED_ORIGINS=
NODE_ENV=development