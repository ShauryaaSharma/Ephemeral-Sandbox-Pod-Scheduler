# Base URLs for the two long-running backend services (wherever you deploy
# them - a VM, their own containers, etc.). Defaults only work when running
# everything on localhost for local dev.
VITE_INIT_SERVICE_URL=http://localhost:3001
VITE_ORCHESTRATOR_URL=http://localhost:3002

# Must match orchestrator-simple's WS_DOMAIN/APP_DOMAIN (see that service's
# src/.env.example) - these are the two domains a project is reachable at.
VITE_WS_DOMAIN=peetcode.com
VITE_APP_DOMAIN=autogpt-cloud.com

# Set to "true" once you've completed cert-manager setup (see README "TLS via
# cert-manager") - switches the per-project socket/iframe connections from
# ws/http to wss/https. Leave as "false" (or unset) for plain-HTTP setups.
VITE_USE_TLS=false
