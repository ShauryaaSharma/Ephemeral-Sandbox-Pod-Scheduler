S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# RS256 public key (PEM) used to verify tokens signed by init-service's
# JWT_PRIVATE_KEY. This pod only ever verifies, never signs. See README
# "Generating the JWT key pair". In a .env file, escape newlines as \n; the
# sandbox-secrets k8s Secret holds the raw multi-line PEM.
JWT_PUBLIC_KEY=
# Injected by the orchestrator at pod-creation time; the socket connection is
# rejected unless the caller's token belongs to this user
OWNER_ID=
# Injected by the orchestrator at pod-creation time (this project's replId)
REPL_ID=