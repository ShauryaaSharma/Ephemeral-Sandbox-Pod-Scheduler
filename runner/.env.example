S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only set when orchestrator-simple issued this pod per-project STS-scoped
# credentials (AWS_STS_ROLE_ARN configured there) - leave blank in the
# legacy bucket-wide-credentials fallback.
AWS_SESSION_TOKEN=
S3_ENDPOINT=
# ES256 (ECDSA P-256) public key (PEM) used to verify tokens signed by
# init-service's JWT_PRIVATE_KEY. This pod only ever verifies, never signs.
# See README "JWT keys". In a .env file, escape newlines as \n; the
# sandbox-secrets k8s Secret holds the raw multi-line PEM.
JWT_PUBLIC_KEY=
# Optional: the *previous* public key, kept during key rotation so tokens
# signed before the rotation keep verifying. See README "Rotating JWT keys".
JWT_PUBLIC_KEY_PREVIOUS=
# Injected by the orchestrator at pod-creation time; the socket connection is
# rejected unless the caller's token belongs to this user
OWNER_ID=
# Injected by the orchestrator at pod-creation time (this project's replId)
REPL_ID=
# This project's own token, gating this pod's internal /health and
# /shutdown endpoints - HMAC-derived by orchestrator-simple from a master
# key only it holds (see orchestrator-simple/src/internalToken.ts), unique
# per project, sent as x-internal-token by stop.ts/reaper.ts.
INTERNAL_API_TOKEN=
# In a real deployment these are substituted by orchestrator-simple at
# /start time from its own ALLOWED_ORIGINS/NODE_ENV (see service.yaml) - set
# here only when running this pod's code standalone for local dev.
ALLOWED_ORIGINS=
NODE_ENV=development
# Max size (bytes) accepted for a single updateContent payload (default: 1MB)
MAX_FILE_UPDATE_BYTES=1048576
# Trailing debounce (ms) before a saved file's S3 write actually fires -
# coalesces a burst of edits into one write per file (default: 1500)
S3_WRITE_DEBOUNCE_MS=1500