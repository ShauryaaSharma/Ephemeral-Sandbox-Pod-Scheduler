# ES256 (ECDSA P-256) public key (PEM) used to verify tokens signed by
# init-service's JWT_PRIVATE_KEY. This service only ever verifies, never
# signs. See README "JWT keys". In a .env file, escape newlines as \n; a
# k8s Secret can hold the raw multi-line PEM.
JWT_PUBLIC_KEY=
# Optional: the *previous* public key, kept during key rotation so tokens
# signed before the rotation keep verifying. See README "Rotating JWT keys".
JWT_PUBLIC_KEY_PREVIOUS=
# Shared with init-service - must point at the same file (see src/db.ts)
OWNERSHIP_DB_PATH=
# The two domains projects are reachable at: <replId>.<WS_DOMAIN> for the
# terminal/editor socket, <replId>.<APP_DOMAIN> for the user's running app
# (Output iframe). Substituted into service.yaml's Ingress at /start time -
# also used directly here to reach a pod's /shutdown and /health.
# Must have wildcard DNS pointed at your ingress controller (see README
# prerequisites), and must match VITE_WS_DOMAIN/VITE_APP_DOMAIN in the
# frontend's .env.
WS_DOMAIN=peetcode.com
APP_DOMAIN=autogpt-cloud.com
# How long a project can sit idle before the reaper auto-stops it (default: 15)
IDLE_TIMEOUT_MINUTES=15
# How often the reaper checks started projects for idleness (default: 60)
REAPER_INTERVAL_SECONDS=60
# How often the health monitor checks started projects for crash-looping (default: 30)
HEALTH_CHECK_INTERVAL_SECONDS=30
# Restart count at which a pod is considered crash-looping, even without an
# explicit CrashLoopBackOff reason yet (default: 5)
CRASH_RESTART_THRESHOLD=5
# Optional: Slack-compatible webhook URL (Slack, Discord w/ Slack-compatible
# endpoint, or any endpoint that accepts {text: "..."}) - fires when a project
# starts crash-looping. Leave unset to skip alerting entirely.
ALERT_WEBHOOK_URL=
# Master key this service alone holds - derivePodToken (src/internalToken.ts)
# HMACs it with each project's replId to get that project's own
# x-internal-token, sent when calling its /health (reaper.ts) and /shutdown
# (stop.ts). Never leaves this service or enters a project namespace - see
# k8s/create-secret.sh.
INTERNAL_API_MASTER_KEY=
# Comma-separated list of frontend origins allowed to call this API. Also
# substituted into every project pod's own ALLOWED_ORIGINS (its Socket.IO
# origin check - see service.yaml/runner's corsOrigins.ts), so this is the
# one place that value is configured. Required when NODE_ENV=production
# (startup fails otherwise); defaults to http://localhost:5173 in development.
ALLOWED_ORIGINS=
NODE_ENV=development
# Per-user token-bucket rate limit on POST /start: burst size / refill window
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated userIds allowed the cluster-wide view on GET /status and
# GET /projects/:replId/status for any project. Unset (default) = every
# caller only ever sees their own projects.
ADMIN_USER_IDS=
# Cluster pod/service CIDRs, substituted into service.yaml's NetworkPolicy
# egress exceptions (default: k3s's defaults). Confirm yours:
#   kubectl cluster-info dump | grep -m1 cluster-cidr
POD_CIDR=10.42.0.0/16
SERVICE_CIDR=10.43.0.0/16
# S3 bucket name - needed here (not just init-service/runner) to build the
# per-project STS session policy's resource ARN below.
S3_BUCKET=
# ARN of an IAM role this service can assume (sts:AssumeRole) to mint
# per-project credentials scoped to code/<replId>/* instead of handing every
# pod the bucket-wide AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY. Leave unset to
# keep the old bucket-wide behavior (NOT isolated per project - see README
# "Scoped S3 credentials"). This service's own AWS credentials (wherever it
# runs - see its deployment's own IAM identity/kubeconfig host) need
# sts:AssumeRole permission on this role.
AWS_STS_ROLE_ARN=
# How long the per-project STS session is valid for (default: 3600 = 1h).
# Not refreshed mid-session if a project runs longer than this - see README.
AWS_STS_SESSION_DURATION_SECONDS=3600
# /workspace's disk ceiling, substituted into service.yaml's emptyDir
# sizeLimit and both containers' ephemeral-storage requests/limits.
WORKSPACE_STORAGE_REQUEST=512Mi
WORKSPACE_STORAGE_LIMIT=1Gi